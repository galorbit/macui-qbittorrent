{
  "name": "macui-qbittorrent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A macOS-styled, fully responsive alternative WebUI for qBittorrent",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "node scripts/check-env.mjs && vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "dev": "node scripts/check-env.mjs && vite",
    "docs:shots": "node scripts/capture-docs-shots.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preinstall": "node scripts/check-env.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "preview": "vite preview",
    "publish:dist": "node scripts/publish-dist-branch.mjs --push",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "verify:dist": "node scripts/verify-dist-tree.mjs dist",
    "verify:entry": "node scripts/verify-public-entry.mjs dist",
    "verify:settings": "node scripts/verify-settings-layout.mjs dist",
    "verify:shots": "node scripts/verify-docs-shots.mjs docs/screenshots"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dompurify": "^3.2.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
